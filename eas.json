{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_USE_MOCK": "true",
        "EXPO_PUBLIC_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_USE_MOCK": "false",
        "EXPO_PUBLIC_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://staging-api.ekopicker.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://staging-api.ekopicker.com"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_USE_MOCK": "false",
        "EXPO_PUBLIC_ENV": "staging",
        "EXPO_PUBLIC_API_URL": "https://staging-api.ekopicker.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://staging-api.ekopicker.com"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_USE_MOCK": "false",
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://api.ekopicker.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.ekopicker.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "YOUR_APPLE_ID@example.com",
        "ascAppId": "YOUR_ASC_APP_ID",
        "appleTeamId": "YOUR_APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./secrets/play-service-account.json",
        "track": "internal"
      }
    }
  }
}
